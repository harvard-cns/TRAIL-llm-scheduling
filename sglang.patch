index 0000000..cc1f88f
--- /dev/null
+++ b/python/sglang/srt/managers/trail_initial_predictor.py
@@ -0,0 +1,89 @@
+import logging
+import re
+from pathlib import Path
+
+import torch
+from transformers import AutoModelForSequenceClassification, AutoTokenizer
+
+logger = logging.getLogger(__name__)
+
+
+# Llama-3 chat template: the predictor was trained on the raw prompt, so keep only the
+# content of the last user turn when the text is a rendered chat.
+_LLAMA3_USER_TURN = re.compile(
+    r"<\|start_header_id\|>user<\|end_header_id\|>\s*(.*?)<\|eot_id\|>", re.S
+)
+
+
+def extract_prompt(text: str) -> str:
+    turns = _LLAMA3_USER_TURN.findall(text)
+    return turns[-1].strip() if turns else text
+
+
+class TrailInitialPredictor:
+    def __init__(self, model_dir: str, device: str = "cpu"):
+        self.model_dir = str(Path(model_dir))
+        self.device = device
+
+        self.tokenizer = AutoTokenizer.from_pretrained(self.model_dir)
+        self.model = AutoModelForSequenceClassification.from_pretrained(self.model_dir)
+        self.model.to(self.device)
+        self.model.eval()
+
+    @torch.inference_mode()
+    def predict_lengths_from_texts(self, texts: list[str]) -> list[float]:
+        if not texts:
+            return []
+
+        texts = [extract_prompt(t) for t in texts]
+        batch = self.tokenizer(
+            texts,
+            padding=True,
+            truncation=True,
+            return_tensors="pt",
+        )
+        batch = {k: v.to(self.device) for k, v in batch.items()}
+
+        outputs = self.model(**batch)
+        logits = outputs.logits
+
+        # Case 1: scalar regression head
+        if logits.ndim == 2 and logits.shape[1] == 1:
+            preds = logits[:, 0]
+            return [max(float(x.item()), 1.0) for x in preds.cpu()]
+
+        # Case 2: classification head over bins
+        if logits.ndim == 2 and logits.shape[1] > 1:
+            probs = torch.softmax(logits, dim=-1)
+
+            num_bins = logits.shape[1]
+
+            # Bins span [0, max_len] output tokens.
+            max_len = (
+                getattr(self.model.config, "trail_max_len", None)
+                or getattr(self.model.config, "max_len", None)
+                or 512
+            )
+
+            bin_edges = torch.linspace(
+                0,
+                float(max_len),
+                steps=num_bins + 1,
+                device=probs.device,
+                dtype=probs.dtype,
+            )
+            bin_midpoints = (bin_edges[:-1] + bin_edges[1:]) / 2.0
+
+            expected = (probs * bin_midpoints.unsqueeze(0)).sum(dim=-1)
+            logger.debug(
+                "TRAIL initial predictor expected lengths=%s",
+                [round(float(x.item()), 2) for x in expected.cpu()],
+            )
+            return [max(float(x.item()), 1.0) for x in expected.cpu()]
+
+        raise RuntimeError(
+            f"Unsupported alpaca_length_predictor logits shape: {tuple(logits.shape)}"
+        )
+
+    def predict_length_from_text(self, text: str) -> float:
+        return self.predict_lengths_from_texts([text])[0]
