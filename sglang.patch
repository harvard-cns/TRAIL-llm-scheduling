index 0000000..f5d2269
--- /dev/null
+++ b/python/sglang/srt/managers/trail_predictor.py
@@ -0,0 +1,230 @@
+import json
+import logging
+import os
+from dataclasses import dataclass
+
+import torch
+import torch.nn as nn
+from safetensors.torch import load_file
+
+logger = logging.getLogger(__name__)
+
+@dataclass
+class TrailPredictorConfig:
+    hidden_size: int = 4096
+    num_labels: int = 10
+    max_len: int = 512
+    probe_layer_idx: int = 11
+    hidden_dim: int = 512
+    device: str = "cpu"
+    dtype: str = "float32"
+
+
+class TrailMLP(nn.Module):
+    def __init__(self, hidden_size: int, hidden_dim: int, num_labels: int):
+        super().__init__()
+        self.fc1 = nn.Linear(hidden_size, hidden_dim)
+        self.act = nn.ReLU()
+        self.fc2 = nn.Linear(hidden_dim, num_labels)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.fc2(self.act(self.fc1(x)))
+
+
+class TrailPredictorRuntime:
+    def __init__(self, model_dir: str):
+        self.model_dir = model_dir
+        self.cfg = self._load_cfg(model_dir)
+        self.model = self._load_model(model_dir, self.cfg)
+        self.bin_edges = torch.linspace(0, self.cfg.max_len, self.cfg.num_labels + 1)
+        self.bin_midpoints = (self.bin_edges[:-1] + self.bin_edges[1:]) / 2
+        self.transition = self._build_transition()
+
+    def _load_cfg(self, model_dir: str) -> TrailPredictorConfig:
+        path = os.path.join(model_dir, "config.json")
+        cfg = TrailPredictorConfig()
+        if os.path.exists(path):
+            with open(path, "r") as f:
+                raw = json.load(f)
+            cfg.hidden_size = raw.get(
+                "hidden_size", raw.get("input_dim", cfg.hidden_size)
+            )
+            cfg.num_labels = raw.get("num_labels", cfg.num_labels)
+            cfg.max_len = raw.get("max_len", raw.get("max_position", cfg.max_len))
+            cfg.probe_layer_idx = raw.get(
+                "probe_layer_idx", raw.get("layer_idx", cfg.probe_layer_idx)
+            )
+            cfg.hidden_dim = raw.get(
+                "hidden_dim", raw.get("intermediate_size", cfg.hidden_dim)
+            )
+            cfg.device = raw.get("device", cfg.device)
+            cfg.dtype = raw.get("dtype", cfg.dtype)
+        return cfg
+
+    def _load_model(self, model_dir: str, cfg: TrailPredictorConfig) -> nn.Module:
+        model = TrailMLP(
+            hidden_size=cfg.hidden_size,
+            hidden_dim=cfg.hidden_dim,
+            num_labels=cfg.num_labels,
+        )
+
+        pt_path = os.path.join(model_dir, "model.pt")
+        st_path = os.path.join(model_dir, "model.safetensors")
+
+        if os.path.exists(pt_path):
+            state = torch.load(pt_path, map_location="cpu")
+        elif os.path.exists(st_path):
+            state = load_file(st_path, device="cpu")
+        else:
+            logger.warning("TRAIL predictor weights not found in %s", model_dir)
+            model.eval()
+            return model
+
+        remap = {}
+        for k, v in state.items():
+            if k.startswith("fc1.") or k.startswith("fc2."):
+                nk = k
+            elif k.startswith("0."):
+                nk = "fc1." + k[len("0.") :]
+            elif k.startswith("2."):
+                nk = "fc2." + k[len("2.") :]
+            elif k.startswith("layers.0."):
+                nk = "fc1." + k[len("layers.0.") :]
+            elif k.startswith("layers.2."):
+                nk = "fc2." + k[len("layers.2.") :]
+            else:
+                nk = k
+            remap[nk] = v
+
+        missing, unexpected = model.load_state_dict(remap, strict=False)
+        if missing:
+            raise RuntimeError(f"Missing predictor weights: {missing}")
+        if unexpected:
+            logger.warning("Unexpected TRAIL predictor weights: %s", unexpected)
+
+        dtype = getattr(torch, cfg.dtype) if isinstance(cfg.dtype, str) else cfg.dtype
+        model = model.to(device=cfg.device, dtype=dtype)
+        model.eval()
+        return model
+
+    def _build_transition(self) -> torch.Tensor:
+        k = self.cfg.num_labels
+        T = torch.zeros(k, k, dtype=torch.float32)
+
+        bin_size = self.cfg.max_len / k
+        step_prob = min(1.0, 1.0 / max(bin_size, 1.0))
+
+        for i in range(k):
+            if i == 0:
+                T[i, i] = 1.0
+            else:
+                T[i, i] = 1.0 - step_prob
+                T[i, i - 1] = step_prob
+
+        T = T / T.sum(dim=-1, keepdim=True).clamp_min(1e-8)
+        return T
+
+    @torch.inference_mode()
+    def logits_to_probs(self, emb: torch.Tensor) -> torch.Tensor:
+        param = next(self.model.parameters())
+        emb = emb.to(device=param.device, dtype=param.dtype)
+        logits = self.model(emb)
+        return torch.softmax(logits, dim=-1)
+
+    def transition_for(self, steps: int) -> torch.Tensor:
+        # Transition matrix across `steps` decode steps (predictions may be refined
+        # only every few steps).
+        steps = max(int(steps), 1)
+        cache = self.__dict__.setdefault("_transition_cache", {})
+        if steps not in cache:
+            cache[steps] = torch.linalg.matrix_power(self.transition, steps)
+        return cache[steps]
+
+    def probs_to_expected_len(self, probs: torch.Tensor) -> float:
+        return float((probs * self.bin_midpoints.to(probs.device)).sum().item())
+
+
+def smooth_probs(prev_post, curr_probs, transition):
+    if prev_post is None:
+        return curr_probs / curr_probs.sum().clamp_min(1e-8)
+
+    prior = prev_post @ transition
+    post = prior * curr_probs
+    post = post / post.sum().clamp_min(1e-8)
+    return post
+
+
+def _to_col(values, n, dev):
+    # Build a [n] float tensor on dev from an optional per-row list.
+    if values is None:
+        return torch.zeros(n, device=dev)
+    return torch.tensor([float(v) for v in values[:n]]).to(dev, non_blocking=True)
+
+
+@torch.inference_mode()
+def predict_prefill_from_embeddings(prefill_avg_embs, max_new_tokens_list, runtime):
+    # Batched on the embedding's device; one CPU transfer at the end.
+    if prefill_avg_embs is None or prefill_avg_embs.shape[0] == 0:
+        return [], [], []
+
+    probs = runtime.logits_to_probs(prefill_avg_embs)          # [B, K] on model device
+    probs = probs / probs.sum(-1, keepdim=True).clamp_min(1e-8)
+    dev = probs.device
+    B = probs.shape[0]
+    mids = runtime.bin_midpoints.to(dev)
+    preds = (probs * mids).sum(-1)                             # [B]
+    cap = _to_col(max_new_tokens_list, B, dev)
+    preds = preds.clamp_min(0.0).minimum(cap) if max_new_tokens_list is not None \
+        else preds.clamp_min(0.0)
+
+    out = torch.cat([preds.unsqueeze(-1), probs], dim=-1).float().cpu()
+    preds_cpu = out[:, 0].tolist()
+    return preds_cpu, list(preds_cpu), list(out[:, 1:].unbind(0))
+
+
+@torch.inference_mode()
+def predict_decode_from_embeddings(
+    prev_prob_dists,
+    decode_embs,
+    generated_lens,
+    max_new_tokens_list,
+    runtime,
+    steps: int = 1,
+):
+    # Batched MLP forward + Bayesian smoothing over the in-flight batch.
+    # Rows without a prior use the current prediction directly.
+    if decode_embs is None or decode_embs.shape[0] == 0:
+        return [], []
+
+    probs = runtime.logits_to_probs(decode_embs)               # [B, K] on model device
+    probs = probs / probs.sum(-1, keepdim=True).clamp_min(1e-8)
+    dev = probs.device
+    B, K = probs.shape
+    T = runtime.transition_for(steps).to(dev)
+    mids = runtime.bin_midpoints.to(dev)
+
+    # Assemble the previous posteriors on the CPU and copy them over in one transfer.
+    prev_cpu = torch.zeros(B, K)
+    has_prev_cpu = torch.zeros(B, dtype=torch.bool)
+    if prev_prob_dists is not None:
+        for i in range(min(B, len(prev_prob_dists))):
+            p = prev_prob_dists[i]
+            if p is not None:
+                prev_cpu[i] = p
+                has_prev_cpu[i] = True
+    prev_mat = prev_cpu.to(dev, non_blocking=True)
+    has_prev = has_prev_cpu.to(dev, non_blocking=True)
+    prev_mat = prev_mat / prev_mat.sum(-1, keepdim=True).clamp_min(1e-8)
+
+    prior = prev_mat @ T                                       # [B, K]
+    post = prior * probs
+    post = post / post.sum(-1, keepdim=True).clamp_min(1e-8)
+    post = torch.where(has_prev.unsqueeze(-1), post, probs)    # no-prior rows -> curr
+
+    preds = (post * mids).sum(-1)                              # [B]
